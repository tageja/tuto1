1) Client: wire Student ID tab
a) API wrapper

Create src/services/backend.students.ts:

import auth from '@react-native-firebase/auth';

const API_BASE = 'https://<REGION>-<PROJECT>.cloudfunctions.net/api';

async function authedFetch(path: string, init?: RequestInit) {
  const token = await auth().currentUser?.getIdToken(true);
  if (!token) throw new Error('NO_AUTH');
  return fetch(`${API_BASE}${path}`, {
    ...(init || {}),
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json',
      ...(init?.headers || {}),
    },
  });
}

export async function searchStudentById(studentCode: string) {
  const res = await authedFetch('/api/students/searchById', {
    method: 'POST',
    body: JSON.stringify({ studentCode }),
  });
  return res.json() as Promise<
    | { ok: true; student: { id: string; fullNameInitials: string; grade: string } }
    | { ok: false; code: string; message?: string }
  >;
}

b) Hook the ID tab into the existing screen

Update app/(onboarding)/guardian-link.tsx:

Import:

import { searchStudentById } from '@/services/backend.students';


Replace the current “ID” placeholder with working UI:

{tab === 'id' && (
  <View>
    <TextInput
      value={code}
      onChangeText={(v) => setCode(v.trim().toUpperCase())}
      placeholder={t('link.id.placeholder')}
      autoCapitalize="characters"
      autoCorrect={false}
      style={{ borderWidth:1, borderColor:'#ddd', borderRadius:12, padding:12, marginBottom:10 }}
    />
    <TouchableOpacity
      onPress={async () => {
        const res = await searchStudentById(code);
        if (!res.ok) {
          Alert.alert(t('link.error.title'), t(mapError(res.code)));
          setStudentPreview(null);
          return;
        }
        setStudentPreview(res.student);
      }}
      style={{ backgroundColor:'#111', padding:12, borderRadius:12, marginBottom:12 }}
    >
      <Text style={{ color:'#fff', textAlign:'center' }}>{t('link.id.cta')}</Text>
    </TouchableOpacity>
  </View>
)}


