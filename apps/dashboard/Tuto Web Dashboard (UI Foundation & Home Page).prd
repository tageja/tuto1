      footer.i18n.vi.ts   (if global i18n not ready)
    /styles/base.css      (reuse tokens; add .footer styles if needed)
    /app/layout.tsx       (include <Footer /> before closing body)
  /public
    /icons/{facebook.svg,instagram.svg,x.svg,youtube.svg,tiktok.svg}
    /tuto-logo.svg
/docs
  PRD-Footer-Tuto.md

6) Component API & Styles
Footer.tsx

Props: none (static links for now).

Imports:

logo SVG from /public/tuto-logo.svg

social icons from /public/icons/*

i18n dictionaries (or useI18n() hook if available)

Structure (pseudocode JSX):

export default function Footer(){
  const t = useT(); // from global or local dictionaries

  return (
    <footer className="footer">
      <div className="container">
        <div className="footer-top">
          <div className="footer-brand">
            <img src="/tuto-logo.svg" alt="Tuto" style={{height:32, width:'auto'}} />
            <p className="muted">{t('blurb')}</p>
            <div className="social">
              <a href="#" aria-label="Facebook"><img src="/icons/facebook.svg" alt="" /></a>
              <a href="#" aria-label="Instagram"><img src="/icons/instagram.svg" alt="" /></a>
              <a href="#" aria-label="X"><img src="/icons/x.svg" alt="" /></a>
              <a href="#" aria-label="YouTube"><img src="/icons/youtube.svg" alt="" /></a>
              <a href="#" aria-label="TikTok"><img src="/icons/tiktok.svg" alt="" /></a>
            </div>
          </div>

          <nav className="footer-cols" aria-label={t('footer')}>
            {/* 6–7 columns: About, Parents, Students, Schools, Institutes, Teachers, Quick Links */}
            {/* Each column: <section aria-labelledby="footer-about"><h3 id="footer-about">...</h3><ul>...</ul></section> */}
          </nav>
        </div>

        <div className="footer-bottom">
          <span className="muted">© {new Date().getFullYear()} Tuto</span>
          <div className="legal">
            <a href="/legal/terms">{t('terms')}</a>
            <a href="/legal/privacy">{t('privacy')}</a>
            <a href="/legal/cookies">{t('cookies')}</a>
          </div>
        </div>
      </div>
    </footer>
  )
}

Minimal CSS (append to base.css)
.footer{ background:#F4F6FA; border-top:1px solid var(--border); }
.footer .container{ padding: var(--space-7) var(--space-6); }
.footer-top{ display:grid; grid-template-columns: 320px 1fr; gap:40px; }
.footer-brand .muted{ margin: 10px 0 16px; }
.footer-brand .social a{ display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius: var(--radius-pill); border:1px solid var(--border); margin-right:8px; }
.footer-cols{ display:grid; grid-template-columns: repeat(6, minmax(150px, 1fr)); gap: 28px 40px; }
.footer-cols h3{ font-size:13px; font-weight:600; margin:0 0 10px; color: var(--text); }
.footer-cols ul{ list-style:none; padding:0; margin:0; }
.footer-cols li{ margin:8px 0; }
.footer-cols a{ color: var(--text); text-decoration:none; }
.footer-cols a:hover{ text-decoration:underline; }
.footer-bottom{ display:flex; align-items:center; justify-content:space-between; gap:16px; padding-top: var(--space-6); border-top:1px solid var(--border); }

@media (max-width: 1199px){
  .footer-top{ grid-template-columns: 1fr; }
  .footer-cols{ grid-template-columns: repeat(3, minmax(150px, 1fr)); }
}
@media (max-width: 767px){
  .footer-cols{ grid-template-columns: repeat(2, minmax(140px, 1fr)); }
}

