8) Implementation Hints (optional but preferred)

Simple i18n provider:

// I18nProvider.tsx
'use client'
import React, {createContext, useContext, useEffect, useState} from 'react'
import en from '@/i18n/en.json'
import vi from '@/i18n/vi.json'
const dict = { en, vi }
const Ctx = createContext<{lang:'vi'|'en'; t:(k:string)=>string; setLang:(l:'vi'|'en')=>void}>(null as any)
export function I18nProvider({children}:{children:React.ReactNode}) {
  const [lang, setLang] = useState<'vi'|'en'>(() => (typeof window!=='undefined' && (localStorage.getItem('lang') as any)) || 'vi')
  useEffect(()=>{ localStorage.setItem('lang', lang) }, [lang])
  const t = (k:string) => (dict[lang][k] ?? k)
  return <Ctx.Provider value={{lang,t,setLang}}>{children}</Ctx.Provider>
}
export const useI18n = ()=>useContext(Ctx)


Language switch:

'use client'
import { useI18n } from '@/app/providers/I18nProvider'
export function LanguageSwitch(){ const {lang,setLang}=useI18n(); return (
  <div style={{display:'inline-flex',gap:6}}>
    <button className={`btn ${lang==='vi'?'btn--primary':'btn--subtle'}`} onClick={()=>setLang('vi')}>VI</button>
    <button className={`btn ${lang==='en'?'btn--primary':'btn--subtle'}`} onClick={()=>setLang('en')}>EN</button>
  </div>
)}


Airtable helper (REST via fetch; Node 18+ has global fetch):

// src/lib/airtable.ts
const key = process.env.AIRTABLE_API_KEY!
const base = process.env.AIRTABLE_BASE_ID!
const host = 'https://api.airtable.com/v0'
async function getMetrics(){ 
  try{
    const r = await fetch(`${host}/${base}/Metrics?maxRecords=1&view=Grid%20view`, { headers:{ Authorization:`Bearer ${key}` }})
    if(!r.ok) throw new Error('AirTable error')
    const j = await r.json()
    const f = j.records?.[0]?.fields || {}
    return {
      weekly_classes: f.weekly_classes ?? 'N/A',
      active_students: f.active_students ?? 'N/A',
      revenue_vnd: typeof f.revenue_vnd==='number' ? f.revenue_vnd : 'N/A',
      partner_schools: f.partner_schools ?? 'N/A',
      active_teachers: f.active_teachers ?? 'N/A',
      active_parents: f.active_parents ?? 'N/A',
    }
  }catch{ return { weekly_classes:'N/A', active_students:'N/A', revenue_vnd:'N/A', partner_schools:'N/A', active_teachers:'N/A', active_parents:'N/A' } }
}
export { getMetrics }


